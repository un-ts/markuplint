{
  "name": "@unts/markuplint",
  "version": "0.0.0",
  "type": "module",
  "description": "Incredible markuplint plugins, make markuplint greater.",
  "repository": "git+https://github.com/un-ts/markuplint.git",
  "author": "JounQin (https://www.1stG.me) <admin@1stg.me>",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf -g .type-coverage coverage '.*cache' 'packages/*/{lib,node_modules,*.tsbuildinfo}'",
    "format": "prettier --write .",
    "lint": "run-p 'lint:*'",
    "lint:es": "eslint . --cache --max-warnings 10",
    "lint:tsc": "tsc --noEmit -p tsconfig.eslint.json",
    "prepare": "simple-git-hooks && patch-package && yarn-berry-deduplicate || exit 0",
    "prettier": "prettier --log-level error",
    "release": "changeset publish",
    "test": "vitest run --coverage",
    "typecov": "type-coverage",
    "version": "changeset version && yarn --no-immutable"
  },
  "devDependencies": {
    "@1stg/common-config": "^16.0.0",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@commitlint/cli": "^21.0.0",
    "@types/node": "^24.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@unts/patch-package": "^8.1.1",
    "@vitest/coverage-istanbul": "^5.0.0",
    "eslint": "^10.0.0",
    "nano-staged": "^1.0.2",
    "npm-run-all2": "^9.0.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "simple-git-hooks": "^2.12.1",
    "snapshot-diff": "^0.10.0",
    "type-coverage": "^2.29.7",
    "type-fest": "^5.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.0.0",
    "vite-tsconfig-paths": "^6.0.0",
    "vitest": "^5.0.4",
    "yarn-berry-deduplicate": "^7.0.0"
  },
  "resolutions": {
    "es5-ext": "npm:@unes/es5-ext@latest",
    "markuplint": "^5.0.0",
    "markuplint-angular-parser": "workspace:*",
    "pm-dedup-core": "2.2.2",
    "prettier": "^3.5.3"
  },
  "commitlint": {
    "extends": "@1stg"
  },
  "prettier": "@1stg/prettier-config",
  "remarkConfig": {
    "plugins": [
      "@1stg/preset"
    ]
  },
  "typeCoverage": {
    "atLeast": 100,
    "cache": true,
    "detail": true,
    "ignoreCatch": true,
    "ignoreAsAssertion": true,
    "ignoreNonNullAssertion": true,
    "strict": true,
    "update": true
  }
}
